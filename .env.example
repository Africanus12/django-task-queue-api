# Use a long, unique random value in every environment. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
DATABASE_URL=postgres://user:password@host:5432/database
REDIS_URL=redis://host:6379/0
# Use .up.railway.app for a Railway wildcard, not *.up.railway.app.
ALLOWED_HOSTS=yourapp.up.railway.app
CORS_ALLOWED_ORIGINS=https://yourfrontend.example
DEFAULT_FROM_EMAIL=noreply@your-domain.example
TASK_WEBHOOK_TIMEOUT=5
# Set to False on Railway so its internal HTTP health check is not redirected.
SECURE_SSL_REDIRECT=False
# Optional server-side provider fallbacks. User-submitted keys are encrypted briefly per task.
OPENAI_API_KEY=
GEMINI_API_KEY=
POKEE_API_KEY=
# Dedicated Fernet key required in production; generate and store outside Git.
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_CREDENTIAL_TTL_SECONDS=300
AI_GENERATE_RATE=5/minute
AI_MODEL_DISCOVERY_RATE=10/minute
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_PROMPT_CHARS=20000
